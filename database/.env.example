# Copy to .env (gitignored) and fill in real values.
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=projello_db

# At least 32 bytes, e.g. `openssl rand -base64 48`
JWT_KEY=change-me-to-a-long-random-string-of-48-plus-chars

# ICE servers used for calls. Keep the public STUN fallback and add a TURN
# provider for users whose networks cannot establish a direct peer connection.
# For Docker, these map to the first configured ICE server.
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:your-turn-provider.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Optional: only needed for photo uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
